<Project Sdk="Microsoft.NET.Sdk">
  <!-- MoonSharp Lua host. Testable headless; must never reference Godot. -->
  <PropertyGroup>
    <RootNamespace>Mechanica.Scripting</RootNamespace>
    <!-- The XML docs feed mechanica.describe's descriptions; doc-comment warnings stay off. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS0419;CS1570;CS1572;CS1573;CS1574;CS1580;CS1584;CS1587;CS1591;CS1711;CS1712;CS1734</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MoonSharp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Bots/behavior.lua" LogicalName="Mechanica.Scripting.Bots.behavior.lua" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Mechanica.Core/Mechanica.Core.csproj" />
  </ItemGroup>
</Project>
