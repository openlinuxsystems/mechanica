{
  // A Workshop (was Workshop Outpost / Mechanic Station): the shared Colony Works repair shop model
  // (tools/structures/workshop.py, docs/art-direction.md) with a working Fabricator in bay 2 (the "part" marker).
  // Its front, the two open bays, faces +Z. The first one is the story's (worldgen.json
  // site POI-37, the quests' "outpost"); every Workshop shares this layout.
  "id": "outpost",
  "name": "Workshop",
  "radius": 46.0,
  "size": [34.0, 9.4, 30.0],
  // Players are safe here: no bot appears inside the Workshop, and no hostile one within 100 m of it.
  "bot_free_radius": 46.0,
  "hostile_free_radius": 100.0,
  "road": "road",
  "placement": {},
  "terrain": [
    { "op": "flatten", "radius": 26.0, "blend": 20.0 }
  ],
  "ground": [{ "ground": "lot", "radius": 24.0, "blend": 8.0, "noise": 4.0 }],
  "models": [
    // Centred on its forecourt: the model's origin is the hall's centre, 0.3 m under its slab, so sinking it 0.28 m
    // leaves the slab flush with the ground (creations drive straight on).
    { "file": "meshes/structures/workshop.glb", "at": [2.0, -0.28, -3.0], "yaw": 0.0 }
  ],
  "markers": [
    // The Fabricator against the back wall of bay 2, facing out: the host puts a working one here that nobody can
    // move or break.
    { "type": "part", "ref": "fabricator", "at": [7.25, 0.02, -10.6], "yaw": 180.0 },
    // The supply dispenser by the right bay's front pier, facing into the bay, and a chest by the tool chests at the back
    // (clear of the tyre stacks): both come filled once from the crate loot table.
    { "type": "part", "ref": "dispenser", "at": [12.0, 0.02, 2.5], "yaw": 90.0, "loot": "crate", "loot_rolls": [2, 4] },
    // A bed in the office (sleep in it to wake here), and the Workshop sign on the forecourt, facing the road: players may
    // take either.
    { "type": "part", "ref": "respawn_bed", "at": [-11.6, 0.02, -1.5] },
    { "type": "part", "ref": "chest", "at": [2.4, 0.02, -11.2], "yaw": 180.0, "loot": "crate", "loot_rolls": [2, 4] },
    { "type": "part", "ref": "outpost_sign", "at": [10.0, 0.02, 13.0], "yaw": 180.0 }
  ]
}
