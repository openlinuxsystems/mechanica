// Parts map batch 16 (Scrap Mechanic parity, after the Crops step): the Beehive and the potted plants. The wiki's stats
// (1.5 kg per weight bar; durability = bars; friction and buoyancy = bars / 10) and Craftbot recipes, each taking a
// Pigment Flower. The Beehive is a station that works on its own (crafting.auto): whenever it is idle it turns a Pigment
// Flower from its slots, or from a container piped to its two-way port, into Beeswax (beeswax_beehive, about one every
// 3 minutes), and sends the wax down the port first. The pots are Settler Patchwork decor in one pot language (a
// brick-red clay pot with a sea-teal band, small on a 1 x 1 footprint and large on 2 x 2) with the Big Pot in Old Stone;
// their recipes are the 3000 group's (Farm and shack decor). Models and icons are built by tools/decor/build_decor.py
// --batch 16 (tools/decor/garden.py) and tools/beehive/build_beehive.py (tools/part_kit/station_kit.py). Re-run with
// tools/author-vanilla.sh.
{
  "format_version": 1,
  "parts": [
    {
      "file": "parts/beehive.json",
      "template": "interactive",
      "set": {
        "name": "Beehive",
        "description": "A settler hive of painted boxes on a plank stand. Keep Pigment Flowers in it, or pipe them to its port, and the bees make a Beeswax about every 3 minutes, sent back down the pipe. Two-way port on the right.",
        "category": "station",
        "mass": 4.5,
        "durability": 7,
        "friction": 0.6,
        "buoyancy": 0.2,
        "flammable": false,
        "stack_size": 5,
        "sound_material": "wood",
        "size": [3, 4, 3],
        "icon": "textures/items/beehive_icon.png",
        "visual": { "color": "#ffffff" },
        "sockets": [{ "id": "base", "type": "structural", "position": [0, -0.5, 0], "normal": [0, -1, 0] }],
        "sounds": {
          "start": "beehive_start",
          "work": "beehive_work",
          "complete": "beehive_complete",
          "place": "place_wood"
        },
        "io_ports": [{ "id": "port", "position": [0.375, -0.125, 0], "normal": [1, 0, 0] }],
        "inventory": { "slots": 4, "accepts": ["pigment_flower", "beeswax"] },
        "crafting": {
          "speed": 1,
          "queue_size": 1,
          "auto": true,
          "clips": { "start": "start", "work": "work_loop", "complete": "complete" }
        },
        "display": { "clips": { "readout": "station", "idle": "idle_loop" } }
      },
      "model": [{ "kind": "mesh", "mesh": "meshes/parts/beehive.glb" }],
      "recipes": [
        {
          "id": "beehive",
          "stations": ["fabricator"],
          "inputs": [
            { "item": "wood_block_2", "count": 50 },
            { "item": "component_kit", "count": 1 },
            { "item": "circuit_board", "count": 4 },
            { "item": "soil_bag", "count": 2 }
          ],
          "outputs": [{ "item": "beehive", "count": 1 }],
          "time": 30,
          "order": 1950
        },
        {
          "id": "beeswax_beehive",
          "stations": ["beehive"],
          "inputs": [{ "item": "pigment_flower", "count": 1 }],
          "outputs": [{ "item": "beeswax", "count": 1 }],
          "time": 180,
          "order": 1951
        }
      ]
    },
