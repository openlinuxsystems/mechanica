{
  // Mining (Boulder Mining spec, Square Rocks redesign): the boulders a drilled large deposit block breaks into, the
  // chunks a medium or small block (or a boulder) breaks into, the Stone and Metal Rods the chunks break into, and the
  // rods' refiner recipes. The deposits and their blocks are world objects in world/worldgen.json.
  // Models: tools/rocks/build_rocks.py. Re-run tools/author-vanilla.sh after editing.
  "format_version": 1,
  "parts": [
    {
      "file": "parts/stone_boulder.json",
      "template": "item",
      "set": {
        "name": "Stone Boulder",
        "description": "A block broken off a rock deposit, too big for the Sledgehammer. Break it with a drill into Stone Chunks.",
        "category": "resource",
        "loose": true,
        "mass": 120,
        "durability": 20,
        "friction": 0.8,
        "buoyancy": 0,
        "flammable": false,
        "stack_size": 1,
        "sound_material": "concrete",
        "size": [4, 4, 4],
        "visual": { "color": "#ffffff", "roughness": 0.95, "metallic": 0 },
        "collision": { "shape": "convex", "mesh": "meshes/items/stone_boulder.glb" },
        "sledge_damage": 0,
        "breaks_into": { "count": 2, "parts": [{ "part": "stone_chunk" }] }
      },
      "model": [{ "kind": "mesh", "mesh": "meshes/items/stone_boulder.glb" }]
    },
    {
      "file": "parts/metal_boulder.json",
      "base": "stone_boulder",
      "set": {
        "name": "Metal-Rich Boulder",
        "description": "A block broken off a metal-rich deposit, veined with ore and too big for the Sledgehammer. Break it with a drill into Metal-Rich Chunks.",
        "mass": 140,
        "sound_material": "metal",
        "collision": { "shape": "convex", "mesh": "meshes/items/metal_boulder.glb" },
        "breaks_into": { "count": 2, "parts": [{ "part": "metal_chunk" }] }
      },
      "model": [{ "kind": "mesh", "mesh": "meshes/items/metal_boulder.glb" }]
    },
    {
      "file": "parts/stone_chunk.json",
      "template": "item",
      "set": {
        "name": "Stone Chunk",
        "description": "A broken piece of a rock deposit. Break it with a drill or the Sledgehammer for its Stone and Metal Rods.",
        "category": "resource",
        "loose": true,
        "mass": 30,
        "durability": 10,
        "friction": 0.8,
        "buoyancy": 0,
        "flammable": false,
        "stack_size": 4,
        "sound_material": "concrete",
        "size": [2, 2, 2],
        "visual": { "color": "#ffffff", "roughness": 0.95, "metallic": 0 },
        "collision": { "shape": "convex", "mesh": "meshes/items/stone_chunk.glb" },
        "sledge_damage": 25,
        "breaks_into": {
          "count": 2,
          "parts": [
            { "part": "stone_rod", "weight": 7 },
            { "part": "metal_rod", "weight": 3 }
          ]
        }
      },
      "model": [{ "kind": "mesh", "mesh": "meshes/items/stone_chunk.glb" }]
    },
    {
      "file": "parts/metal_chunk.json",
      "base": "stone_chunk",
      "set": {
        "name": "Metal-Rich Chunk",
        "description": "A broken piece of a metal-rich deposit, veined with ore. Break it with a drill or the Sledgehammer for mostly Metal Rods.",
        "mass": 36,
        "sound_material": "metal",
        "collision": { "shape": "convex", "mesh": "meshes/items/metal_chunk.glb" },
        "breaks_into": {
          "count": 2,
          "parts": [
            { "part": "stone_rod", "weight": 3 },
            { "part": "metal_rod", "weight": 7 }
          ]
        }
      },
      "model": [{ "kind": "mesh", "mesh": "meshes/items/metal_chunk.glb" }]
    },
    {
      "file": "parts/stone_rod.json",
      "template": "item",
      "set": {
        "name": "Stone Rod",
        "description": "A bar of rough stone. Hold Use on it with the Refine Tool, or put it in a Refiner, for 20 Scrap Stone Blocks.",
        "category": "resource",
        "loose": true,
        "mass": 12,
        "friction": 0.7,
        "buoyancy": 0,
        "flammable": false,
        "stack_size": 10,
        "sound_material": "concrete",
        "size": [1, 1, 4],
        "visual": { "color": "#ffffff", "roughness": 0.95, "metallic": 0 },
        "refine": [{ "item": "scrap_stone_block", "count": 20 }]
      },
      "model": [{ "kind": "mesh", "mesh": "meshes/items/stone_rod.glb" }],
      "recipes": [
        {
          "id": "stone_rod",
          "stations": ["refiner"],
          "inputs": [{ "item": "stone_rod", "count": 1 }],
          "outputs": [{ "item": "scrap_stone_block", "count": 20 }],
          "time": 5,
          "order": 2630
        }
      ]
    },
    {
      "file": "parts/metal_rod.json",
      "base": "stone_rod",
      "set": {
        "name": "Metal Rod",
        "description": "A bar of raw metal. Hold Use on it with the Refine Tool, or put it in a Refiner, for 20 Metal Blocks.",
        "mass": 16,
        "friction": 0.4,
        "sound_material": "metal",
        "visual": { "color": "#ffffff", "roughness": 0.35, "metallic": 0.9 },
        "sounds": { "pickup": "pickup_metal", "drop": "drop_metal" },
        "refine": [{ "item": "metal_block", "count": 20 }]
      },
      "model": [{ "kind": "mesh", "mesh": "meshes/items/metal_rod.glb" }],
      "recipes": [
        {
          "id": "metal_rod",
          "stations": ["refiner"],
          "inputs": [{ "item": "metal_rod", "count": 1 }],
          "outputs": [{ "item": "metal_block", "count": 20 }],
          "time": 5,
          "order": 2640
        }
      ]
    }
  ]
}
