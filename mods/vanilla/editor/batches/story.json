          { "shape": "box", "size": [14.0, 3.0, 0.4], "at": [0.0, 1.5, -6.8], "color": "#5b4a3a" },
          { "shape": "cylinder", "radius": 0.2, "height": 8.0, "at": [5.0, 4.0, 5.0], "color": "#4a4f55" },
