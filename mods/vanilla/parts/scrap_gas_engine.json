{
  "id": "scrap_gas_engine",
  "name": "Scrap Gas Engine",
  "description": "A rattly starter engine from scrap. It turns up to two wheel bearings linked to it, with a seat's throttle as its input: it runs while someone sits in a linked seat, and on its own with no seat or switch linked. Burns gasoline faster than a Gas Engine.",
  "category": "interactive",
  "mass": 10,
  "durability": 2,
  "friction": 0.5,
  "buoyancy": 0.2,
  "flammable": true,
  "stack_size": 5,
  "sound_material": "scrap",
  "size": [2, 2, 2],
  "mesh": "meshes/parts/scrap_gas_engine.glb",
  "icon": "textures/items/scrap_gas_engine_icon.png",
  "visual": {
    "color": "#ffffff"
  },
  "sockets": [
    {
      "id": "base",
      "type": "structural",
      "position": [0, -0.25, 0],
      "normal": [0, -1, 0]
    }
  ],
  "script": "scripts/engine.lua",
  "sounds": {
    "start": "engine_start",
    "loop": "engine_idle",
    "stop": "engine_sputter",
    "sputter": "engine_sputter",
    "rev": "engine_rev"
  },
  "logic": {
    "inputs": 4,
    "outputs": 2,
    "kind": "power"
  },
  "settings": [
    {
      "id": "gear",
      "name": "Power",
      "type": "number",
