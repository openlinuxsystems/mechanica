      "scale": [1.0, 1.15],
      "sink": 0.15,
      "max_slope": 0.3,
      "health": 260.0,
      "damage_from": ["drill"],
      "breaks_into": { "count": 2, "parts": [{ "part": "metal_chunk" }] }
    },
    // Trees (Tree Harvesting spec): Birch is small, Leafy and Spruce medium, Pine large. A felled tree tips over as its
