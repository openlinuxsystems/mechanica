  // Destructible objects (D11): placeholder primitives until meshes are authored, a model (mesh, with an optional far lod), or a
  // built-in flora model.
  // Objects with a health break under sledge hits and weapons (chunk 20) and leave their drops on the ground; damage_from
  // limits what hurts them. Outcrops (Boulder Mining spec) stack 1 m cubes that only a spinning drill breaks, each into
  // chunks (parts/stone_chunk.json, parts/metal_chunk.json) that break into Stone and Metal Rods.
  "objects": [
    {
      "id": "rock_outcrop",
      "outcrop": { "cubes": [6, 20], "height": [1, 4] },
      "collider": { "shape": "box", "size": [1.0, 1.0, 1.0], "at": [0.0, 0.5, 0.0] },
      "pieces": [{ "shape": "box", "size": [1.0, 1.0, 1.0], "at": [0.0, 0.5, 0.0], "color": "#8f8a82" }],
      "mesh": { "file": "meshes/world/rock_cube.glb", "at": [0.0, 0.5, 0.0] },
      "footprint": 4.0,
      "scale": [1.0, 1.2],
      "sink": 0.15,
      "max_slope": 0.3,
      "health": 200.0,
      "damage_from": ["drill"],
      "breaks_into": { "count": 2, "parts": [{ "part": "stone_chunk" }] }
    },
    {
      "id": "metal_outcrop",
      "outcrop": { "cubes": [5, 12], "height": [1, 3] },
      "collider": { "shape": "box", "size": [1.0, 1.0, 1.0], "at": [0.0, 0.5, 0.0] },
