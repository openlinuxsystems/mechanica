; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mechanica"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]

GameSettings="*res://scripts/Settings/GameSettings.cs"
UiRoot="*res://scripts/Ui/UiRoot.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Mechanica.Game"
project/solution_directory="../"

[gui]

timers/tooltip_delay_sec=0.25

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=30
jolt_physics_3d/simulation/position_steps=10
jolt_physics_3d/limits/max_angular_velocity=150.0

[rendering]

textures/vram_compression/import_etc2_astc=true
