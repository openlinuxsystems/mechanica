{
  // Building by hand (SI units). Loaded by game/scripts/Building/BuildSync.cs.
  "reach": 7.5,
  "max_parts_per_creation": 4096,
  "clearance_scale": 0.9,
  // A part built within this many metres of the ground is anchored there and stays put.
  "anchor_margin": 0.05,
  // Placing and removing parts (UI spec §8, §9): hold to align, move to drag, hold right click to remove.
  "placement": {
    "align_hold_seconds": 0.15,
    "drag_seconds": 0.1,
    "drag_max_per_axis": 16,
    "remove_seconds": 0.6,
    "remove_seconds_by_material": { "wood": 0.4, "metal": 0.7, "concrete": 0.9 },
    "rollback_seconds": 0.4
  },
  // Connect Tool (UI spec §9, §10, §12): nodes, 3 px lines with chevrons, drag snap (px at 1080p).
  "connect": {
    "node_pixels": 14,
    "hover_scale": 1.2,
    "pulse_seconds": 0.8,
    "line_width": 3,
    "chevron_spacing": 40,
    "lane_gap": 5,
    "snap_metres": 0.5,
    "invalid_alpha": 0.3,
    "flash_seconds": 0.6,
    "range": 40
  },
  // Weld Tool (UI spec §8): the blue seam on the joined faces fades over this long.
  "weld": {
    "seam_seconds": 1.5
  },
  // Lift (UI spec §2, §5, §9): hold right click to take it away; E opens the blueprint menu.
  "lift": {
    "platform_size": 1.0,
    "base_height": 0.5,
    "level_height": 0.25,
    "max_level": 20,
    "model": "vanilla:meshes/lift/lift.glb",
    "raise_speed": 0.9,
    "raise_acceleration": 4.0,
    "end_stop_sound": "impact_metal",
    "remove_hold_seconds": 0.5,
    "refuse_stored_items": true,
    "max_blueprints": 50,
    "blueprint_max_bytes": 1048576
  },
  "paint": {
    "palette": [
      "#e8e8e8", "#9a9a9a", "#3a3a3a", "#141414",
      "#d03030", "#e86820", "#f0d830", "#a0d040",
      "#40a040", "#20a0a0", "#3070d0", "#203890",
      "#8040b0", "#d050a0", "#8a5a30", "#e8c8a0"
    ],
    "max_parts_per_action": 256,
    "drag_flush_seconds": 0.1
  },
  "sledge": {
    // Chase's sledgehammer spec: one swing a second, the hit landing at the click (2026-10-18; was 0.6 s after it), 3 m
    // from the head. The swing animation skips its wind-up to match (character.json gesture_start).
    "damage": 10,
    "health_per_durability": 10,
    "swing_seconds": 1.0,
    "strike_seconds": 0,
    "reach": 3.0,
    // Knockback (N·s, mass × Δv) on whatever is hit, never faster than max_knockback_speed (m/s) for something light.
    // Players and bots count as character_mass kg and get knockback_lift m/s upward; a bot slows by knockback_drag m/s².
    "impulse": 5000,
    "max_knockback_speed": 4.0,
    "character_mass": 80,
    "knockback_lift": 2.5,
    "knockback_drag": 8,
    "shake_metres": 0.03,
    "shake_seconds": 0.2,
    // Combat damage to players and bots; world objects take their own sledge_damage (worldgen.json), else object_damage.
    "combat_damage": 20,
    "object_damage": 10
  }
}
