  "sounds": [
    { "at": 4.0, "event": "air_whoosh", "on": "camera" },
    { "at": 12.0, "event": "scuttler_explode", "on": "explosion" },
    { "at": 12.1, "event": "break_metal", "on": "housing" },
    { "at": 15.0, "event": "impact_metal", "on": "housing" },
    { "at": 19.6, "event": "impact_metal", "on": "ship" },
    { "at": 20.2, "event": "break_metal", "on": "ship" },
    { "at": 22.0, "event": "impact_metal", "on": "ship" }
  ],
  "engine_loop": "thruster_loop",
  "fade_in": 1.0,
  "black": [26.0, 27.5],
  "player_fade_in": 1.0,
  "skip_fade": 0.4,
  "letterbox": 0.1
