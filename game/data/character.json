{
  // How player characters are animated (engine settings, not moddable). Loaded by game/scripts/Player/CharacterAssets.cs.
  // The skeleton and the clip names are fixed in src/Mechanica.Core/Characters/CharacterRig.cs.
  "animations": "vanilla:meshes/characters/humanoid_animations.glb",
  "hand_tools": "vanilla:meshes/characters/hand_tools.glb",
  // Ground speed (m/s) each moving clip is authored for; it plays one cycle per clip length at that speed.
  "clip_speeds": {
    "walk": 1.5,
    "jog": 4.0,
    "run": 7.0,
    "crouch_walk": 1.5,
    "swim": 2.5
  },
  "step_phases": [0.0, 0.5],
  "stroke_phases": [0.25, 0.75],
  "mode_fade": 0.15,
  "hold_fade": 0.2,
  "gesture_fade_in": 0.06,
  "gesture_fade_out": 0.12,
  // Gestures that play faster or slower than authored, in seconds, from their gesture_start to the end.
  "gesture_seconds": {
    "sledge_swing": 0.42
  },
  // Where a gesture starts in its clip (0 to 1); the part before never plays. The sledge swing skips its wind-up and
  // starts with the head already coming down: the hit lands at the click (sledge.strike_seconds 0) and the head meets
  // it 0.07 s later, at the clip's impact (0.25 s into the 0.6 s clip).
  "gesture_start": {
    "sledge_swing": 0.3
  },
  "air_grace": 0.15,
  "jump_detect_speed": 1.5,
  "land_min_speed": 2.5,
  "hard_land_speed": 9.0,
  "min_step_speed": 0.3,
  "max_body_turn_degrees": 60.0,
  "body_turn_rate": 540.0,
  "seated_offset": 0.0,
  // Sitting (src/Mechanica.Core/Characters/CharacterSettings.cs SeatRideSettings). The legs blend the chair pose (sit) with the
  // low-seat pose (sit_low) so the hips land clip_hips above the feet's floor, hips_above_cushion over the seat's cushion. The
  // hips bob and the upper body sways on springs that each change in the seat's velocity pushes (times the seat's bounce):
  // a bump throws the hips, braking tips the body forward, a turn leans it out. Sitting down sinks in at settle_speed.
  "seat": {
    // From tools/characters/build_characters.py (SIT_HIPS, SIT_LOW_HIPS measured on the rig).
    "clip_hips": { "sit": 0.53, "sit_low": 0.308 },
    "hips_above_cushion": 0.14,
    "bob_stiffness": 160,
    "bob_damping": 11,
    "bob_gain": 0.5,
    "max_bob": 0.06,
    "lean_stiffness": 70,
    "lean_damping": 9,
    "lean_gain": 0.4,
    "max_lean_degrees": 12,
    "settle_speed": 0.35,
    "max_impulse": 8
  },
  // How items look in hand (prop, and the gesture using one plays), by item id, then by part category.
  "item_poses": {
    "water_bucket": { "prop": "water_bucket", "gesture": "bucket_fill" },
    "water_bucket_full": { "prop": "water_bucket_full", "gesture": "bucket_throw" },
    "potato_blaster": { "prop": "potato_blaster", "gesture": "fire_gun" },
    "potato_scattergun": { "prop": "potato_blaster", "gesture": "fire_gun" },
    "potato_launcher": { "prop": "potato_blaster", "gesture": "fire_gun" },
    "popper": { "prop": "item", "gesture": "throw" },
    "glowstick": { "prop": "item", "gesture": "throw" },
    "carrot_seed": { "prop": "item", "gesture": "plant" },
    "potato_seed": { "prop": "item", "gesture": "plant" },
    "tomato_seed": { "prop": "item", "gesture": "plant" },
    "soil_bag": { "prop": "soil_bag", "gesture": "bag_spill" }
  },
  "category_poses": {
    "consumable": { "prop": "item", "gesture": "eat" },
    "weapon": { "prop": "item", "gesture": "throw" }
  },
  // The water bucket in hand (game/scripts/Player/BucketRig.cs; the model and clips are tools/characters/build_characters.py).
  // Lengths in m in the bucket's own frame: origin in the middle of its base, +Z up its axis, the handle hinged on the X axis.
  "bucket": {
    "hinge_height": 0.244,
    // From the hinges to the middle of the handle's grip.
    "handle_length": 0.21,
    // How far the handle falls forward from upright when nothing holds it up (an empty bucket).
    "handle_lowered_degrees": 136,
    // Where the fist holds the back of the rim of an empty bucket.
    "rim_grip": [0.0, 0.152, 0.282],
    // The water: the inside's floor, the surface when full, and the inside's radius at the floor and the rim.
    "floor_height": 0.024,
    "water_height": 0.215,
    "inner_radius_floor": 0.112,
    "inner_radius_rim": 0.138,
    "rim_height": 0.288,
    // Gestures whose effect waits for the moment in the clip it happens: the bucket dipping in, the water leaving, the
    // bucket touching down.
    "release_seconds": {
      "bucket_fill": 0.44,
      "bucket_throw": 0.36,
      "bucket_place": 0.42,
      "bucket_place_full": 0.42
    },
    // Each bucket clip's [seconds, grip, tilt degrees, water]: grip 0 holds the rim, 1 the handle; tilt swings the bucket
    // forward about its hinges while the hand keeps the handle; water 0 is empty, 1 full. Eased between keys.
    "motion": {
      "bucket_fill": [[0, 0, 0, 0], [0.34, 0, 0, 0], [0.44, 0, 0, 0.2], [0.6, 0, 0, 0.9], [0.66, 0, 0, 1], [0.72, 0, 0, 1], [0.9, 1, 0, 1], [1.1, 1, 0, 1]],
      "bucket_throw": [[0, 1, 0, 1], [0.2, 1, -14, 1], [0.32, 1, 55, 1], [0.4, 1, 100, 0.45], [0.48, 1, 112, 0], [0.58, 1, 60, 0], [0.68, 1, 8, 0], [0.76, 0.5, 0, 0], [0.84, 0, 0, 0], [0.9, 0, 0, 0]],
      "bucket_place": [[0, 0, 0, 0], [0.8, 0, 0, 0]],
      "bucket_place_full": [[0, 1, 0, 1], [0.8, 1, 0, 1]]
    }
  },
  // The Paint Tool's tank (game/scripts/Building/PaintToolLook.cs; the model and clips are
  // tools/characters/build_characters.py). Each clip's keys are [seconds, twist degrees, pull metres]: the tank turns about
  // its axis (negative unscrews it, seen from behind) and slides back out of its collar. Eased between keys.
  "paint_tool": {
    "reload_seconds": 1.4,
    "tank": {
      "paint_reload": [[0, 0, 0], [0.38, 0, 0], [0.52, -85, 0], [0.62, -85, 0.03], [0.74, -85, 0.03], [0.84, -85, 0], [0.98, 0, 0], [1.4, 0, 0]]
    }
  },
  "head_pitch_share": 0.6,
  // First-person arms: where the arms-only model stands from the camera (right, up, back, in metres) and how far it tips forward.
  "first_person_offset": [0.0, -1.24, 0.14],
  "first_person_pitch_degrees": 14
}
