{
  // Bot engine limits and timings (chunk 21, SI units). A bot's own numbers live in its mod's
  // bots/*.json, and raids in raids/raids.json. Loaded by game/scripts/Bots/BotSync.cs; see
  // src/Mechanica.Core/Bots/BotSettings.cs.
  "max_bots": 128,
  "think_interval": 0.1,
  "corpse_seconds": 3.0,
  "range_tolerance": 0.4,
  "player_radius": 0.4,
  "max_spawn_distance": 8192.0,
  // A bot stays engaged (red eye, fighting stance) this long after it last spotted a target, attacked or was hurt.
  "engaged_seconds": 4.0,
  // POI guards (the bot markers in pois/*.json): they appear when a player comes within the wake distance,
  // leave when everyone is past the sleep distance, and a killed guard's post waits guard_respawn seconds.
  "guard_wake_distance": 64.0,
  "guard_sleep_distance": 96.0,
  "guard_respawn": 1200.0
}
