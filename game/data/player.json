{
  // On-foot player tuning (SI units). Loaded by game/scripts/Player/PlayerController.cs.
  "walk_speed": 4.0,
  "sprint_speed": 7.0,
  "ground_acceleration": 40.0,
  // Above walk_speed the pace builds and eases off more gently, so going from a walk to a sprint and back shows.
  "sprint_acceleration": 9.0,
  "sprint_deceleration": 14.0,
  "air_acceleration": 8.0,
  "jump_speed": 4.5,
  "gravity": 9.81,
  "max_fall_speed": 50.0,
  "max_pitch_degrees": 89.0,
  "height": 1.8,
  "radius": 0.35,
  "eye_height": 1.6,
  "push_force": 600.0,
  // The tallest edge walked up without jumping: one block (0.25 m) plus room for uneven ground (stairs, soil plots).
  "step_height": 0.35,
  "crawl_speed": 1.5,
  // Crouching: a shorter capsule (fits under 1.2 m gaps) and a lower camera.
  "crouch_height": 1.2,
  "crouch_eye_height": 1.05,
  "stance_speed": 4.0,
  // Swimming: from swim_depth (feet below the surface) the player swims, floating at float_depth.
  "swim_depth": 1.2,
  "float_depth": 1.4,
  "swim_speed": 2.5,
  "swim_sprint_speed": 4.0,
  "swim_vertical_speed": 2.0,
  "swim_acceleration": 6.0,
  "buoyancy": 3.0,
  // Jumping at the surface lifts the feet this far above the water, so a swimmer can climb out onto an edge this high.
  "swim_leap_height": 0.6,
  "wade_speed_scale": 0.7,
  // Ladders (parts with "climbable"): walk into one to grab it, forward climbs up and back down at climb_speed, strafe
  // moves along the rungs. Jump pushes off; at the top the player steps onto the floor behind it. A player let go can
  // grab again after climb_regrab_seconds.
  "climb_speed": 2.0,
  "climb_side_speed": 1.0,
  "climb_reach": 0.25,
  "climb_jump_speed": 3.5,
  "climb_jump_up": 3.0,
  "climb_regrab_seconds": 0.4,
  "climb_top_out_speed": 2.5,
  // Camera (UI spec §6): first-person by default; zoom out (C) and in (X) by a step, in past the closest goes first-person.
  // camera_distance is where the third-person camera sits when it pulls back (death, spectating, or starting third-person).
  "camera_starts_first_person": true,
  "camera_distance": 3.5,
  "camera_min_distance": 1.5,
  "camera_max_distance": 6.0,
  "camera_zoom_step": 1.0,
  // Over the shoulder: right of and above the head, so the player doesn't hide the crosshair.
  "camera_shoulder": 0.5,
  "camera_raise": 0.25,
  // Seats (UI spec §9, §10): sitting down and standing up take this long; the seat's interior camera looks from the seated
  // body's eyes (seated_eye_height over the seat when there is no body), and Ctrl switches to a chase camera behind and
  // above the seat that catches up at chase_stiffness.
  "seat_transition_seconds": 0.3,
  "seated_eye_height": 1.1,
  "chase_distance": 6.0,
  "chase_height": 2.2,
  "chase_stiffness": 8.0
}
